# copy to .env (or ~/.hashiya/.env)
JIRA_URL=https://yourteam.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=xxxx
# local model via ollama (defaults shown)
# HASHIYA_MODEL=mistral:latest
# OLLAMA_URL=http://localhost:11434
# colon-separated repo paths, ~ ok
HASHIYA_REPOS=~/work/api-server:~/work/frontend
# git author match for "my commits"; defaults to JIRA_EMAIL if unset
# GIT_AUTHOR=you@company.com
